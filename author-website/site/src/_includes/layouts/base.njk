<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {{ site.author }}{% else %}{{ site.author }}{% endif %}</title>
  <meta name="description" content="{{ description or site.heroSupport }}">
  <link rel="canonical" href="https://{{ site.domain }}{{ page.url }}">

  <!-- Literary serifs: Spectral (body) + Source Serif 4 (headings). -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,500;1,400&family=Source+Serif+4:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">

  <!-- Person schema (spec §16). -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.author }}",
    "url": "https://{{ site.domain }}",
    "jobTitle": "Author"
  }
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/">{{ site.author }}</a>
      <nav class="nav" aria-label="Primary">
        <ul>
          {% for item in site.nav %}
          <li><a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  {% if not hideNewsletter %}
  <section class="news" aria-labelledby="news-h">
    <div class="wrap">
      <h2 id="news-h">Stay in the work</h2>
      <p>New essays and word of each book as it arrives. The list is the one place I reach readers directly.</p>
      <p><a class="btn" href="/subscribe/">Join the readers</a></p>
    </div>
  </section>
  {% endif %}

  <footer class="site-footer">
    <div class="wrap">
      <p>&copy; {% year %} {{ site.author }}</p>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/books/">Books</a></li>
          <li><a href="/essays/">Essays</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/press/">Press</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
    </div>
  </footer>
</body>
</html>

---
layout: layouts/base.njk
---
<article class="essay">
  <section class="hero">
    <div class="wrap narrow">
      <p class="eyebrow">Essay</p>
      <h1>{{ title }}</h1>
      {% if standfirst %}<p class="lede">{{ standfirst }}</p>{% endif %}
      {% if date %}<p class="essay-date">{{ date.toDateString() }}</p>{% endif %}
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow prose">
      {{ content | safe }}
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow">
      <a href="/essays/">&larr; All essays</a>
    </div>
  </section>
</article>

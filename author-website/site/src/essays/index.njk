---
layout: layouts/base.njk
title: Essays
description: Essays by Kenneth Granberry — shorter pieces, and the thinking beneath the books.
permalink: /essays/
---

<section class="hero">
  <div class="wrap">
    <h1>Essays</h1>
    <p class="lede">Shorter pieces, and the thinking beneath the books.</p>
  </div>
</section>

<section class="section">
  <div class="wrap narrow">
    {% set essays = collections.essays | reverse %}
    {% if essays.length %}
    <ul class="essay-list">
      {% for post in essays %}
      <li>
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        {% if post.data.standfirst %}<p class="hook">{{ post.data.standfirst }}</p>{% endif %}
        {% if post.data.date %}<p class="essay-date">{{ post.data.date.toDateString() }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p>Essays will appear here.</p>
    {% endif %}
  </div>
</section>

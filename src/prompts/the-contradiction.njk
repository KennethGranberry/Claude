  .btn.primary{background:var(--star);color:var(--night);border-color:var(--star);}
  .btn.primary:hover{background:var(--star-bright);border-color:var(--star-bright);}
  .btn.ghost{background:transparent;color:var(--ink-soft);border-color:var(--rule-light);}
  .btn.ghost:hover{color:var(--ink);border-color:var(--star);}

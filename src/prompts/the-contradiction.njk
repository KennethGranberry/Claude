---
title: The Contradiction — A Socratic Sequence · Kenneth Granberry
description: Build the strongest case against yourself, then find where your own commitments cannot all be true at once. A guided Socratic sequence for use with any AI.
---
{% extends "base.njk" %}

{% block styles %}
<style>
  :root{ --measure:64ch; }

  /* hero */
  .hero{background:var(--night);color:var(--paper);padding:150px 0 92px;position:relative;overflow:hidden;}
  .hero::before{content:"";position:absolute;left:50%;top:-26%;transform:translateX(-50%);width:130%;height:78%;background:radial-gradient(ellipse at center,rgba(210,168,92,.13),rgba(210,168,92,0) 60%);pointer-events:none;}
  .hero .eyebrow{color:var(--star);display:block;margin-bottom:22px;}
  .hero h1{font-size:clamp(2.6rem,6vw,4.4rem);line-height:1.04;letter-spacing:-.01em;color:var(--paper);}
  .hero .sub{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:clamp(1.25rem,2.6vw,1.7rem);line-height:1.3;color:var(--star-bright);max-width:30ch;margin:24px 0 0;}
  .hero .why{margin:26px 0 0;color:var(--paper);font-size:1.16rem;line-height:1.5;max-width:48ch;}
  .hero .meta{margin:22px 0 0;color:var(--mist);font-size:1rem;max-width:46ch;}
  .hero .meta strong{color:var(--paper);font-weight:500;}

  /* progress */
  .progress-bar{position:sticky;top:68px;z-index:40;background:rgba(242,236,222,.92);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);border-bottom:1px solid var(--rule-light);}
  .progress-bar .wrap{display:flex;align-items:center;justify-content:space-between;height:56px;gap:20px;}
  .steplabel{font-family:"EB Garamond",serif;font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap;}
  .steplabel b{color:var(--ink);font-weight:600;}
  .dots{display:flex;gap:10px;align-items:center;}
  .dots span{width:9px;height:9px;border-radius:50%;background:var(--rule-light);transition:background .3s ease,transform .3s ease;}
  .dots span.done{background:var(--star);}
  .dots span.current{background:var(--star-bright);transform:scale(1.35);box-shadow:0 0 0 4px rgba(210,168,92,.16);}

  /* stage */
  .stage{padding:64px 0 40px;min-height:52vh;}
  .step{display:none;animation:fade .5s ease both;}
  .step.active{display:block;}
  @keyframes fade{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}
  .step .kicker{color:var(--star);display:block;margin-bottom:18px;}
  .step h2{font-size:clamp(1.7rem,3.4vw,2.5rem);line-height:1.12;color:var(--ink);max-width:22ch;margin-bottom:26px;}
  .step p{max-width:var(--measure);margin:0 0 20px;color:#33353D;}
  .step p.lead{font-size:1.16rem;color:var(--ink);}
  .step em{font-style:italic;}
  .pull{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:1.45rem;line-height:1.3;color:var(--ink);border-left:2px solid var(--star);padding:4px 0 4px 24px;margin:30px 0;max-width:40ch;}

  .note{background:var(--paper-warm);border:1px solid var(--rule-light);border-left:3px solid var(--star);padding:22px 26px;margin:28px 0;max-width:var(--measure);}
  .note .tag{font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:var(--star);display:block;margin-bottom:10px;font-weight:500;}
  .note p{margin:0;color:var(--ink-soft);font-size:1rem;}
  .note.caution{border-left-color:var(--mist-dim);}
  .note.caution .tag{color:var(--mist-dim);}

  /* watch-for list */
  .watch{list-style:none;padding:0;margin:26px 0;max-width:var(--measure);}
  .watch li{padding:16px 0;border-top:1px solid var(--rule-light);}
  .watch li:last-child{border-bottom:1px solid var(--rule-light);}
  .watch b{font-family:"Cormorant Garamond",serif;font-style:italic;font-weight:600;font-size:1.15rem;color:var(--ink);display:block;margin-bottom:3px;}
  .watch span{color:var(--ink-soft);font-size:1rem;}

  /* textarea */
  .field{max-width:var(--measure);margin:24px 0;}
  .field label{display:block;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:10px;}
  textarea{width:100%;min-height:140px;resize:vertical;background:#FBF7EE;border:1px solid var(--rule-light);border-radius:3px;padding:16px 18px;font-family:"EB Garamond",serif;font-size:1.05rem;line-height:1.55;color:var(--ink);}
  textarea:focus{outline:none;border-color:var(--star);box-shadow:0 0 0 3px rgba(210,168,92,.14);}

  /* prompt box */
  .promptbox{max-width:var(--measure);margin:26px 0;border:1px solid var(--rule-dark);border-radius:4px;background:var(--night);color:#E7E2D6;overflow:hidden;box-shadow:0 18px 50px -28px rgba(13,17,26,.6);}
  .promptbox .bar{display:flex;align-items:center;justify-content:space-between;padding:13px 18px;background:var(--night-deep);border-bottom:1px solid var(--rule-dark);}
  .promptbox .bar .lbl{font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:var(--star);}
  .copybtn{font-family:"EB Garamond",serif;font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--night);background:var(--star);border:none;border-radius:3px;padding:8px 16px;cursor:pointer;transition:background .25s ease;}
  .copybtn:hover{background:var(--star-bright);}
  .copybtn.copied{background:#8FA577;color:#0D111A;}
  .prompttext{padding:22px 22px 26px;font-size:.96rem;line-height:1.6;white-space:pre-wrap;max-height:330px;overflow:auto;color:#DCD7CA;}
  .prompttext::-webkit-scrollbar{width:10px;}
  .prompttext::-webkit-scrollbar-thumb{background:rgba(210,168,92,.3);border-radius:6px;}
  .prompttext .fill{color:var(--star-bright);font-style:italic;}

  /* nav buttons */
  .stepnav{display:flex;align-items:center;justify-content:space-between;gap:18px;max-width:var(--measure);margin:46px 0 0;padding-top:26px;border-top:1px solid var(--rule-light);}

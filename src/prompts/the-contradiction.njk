  /* unlock / capture */
  .unlock{background:var(--night);color:var(--paper);margin-top:30px;border-radius:5px;padding:54px 44px;position:relative;overflow:hidden;}
  .unlock::before{content:"";position:absolute;left:50%;top:-40%;transform:translateX(-50%);width:120%;height:80%;background:radial-gradient(ellipse at center,rgba(210,168,92,.12),rgba(210,168,92,0) 62%);pointer-events:none;}
  .unlock .eyebrow{color:var(--star);display:block;margin-bottom:18px;}
  .unlock h3{font-size:clamp(1.5rem,3vw,2.1rem);color:var(--paper);max-width:24ch;margin-bottom:18px;}
  .unlock p{color:#D2CDC1;max-width:54ch;margin:0 0 18px;}
  .arc{list-style:none;padding:0;margin:22px 0 28px;max-width:54ch;}
  .arc li{display:flex;align-items:baseline;gap:14px;padding:9px 0;border-bottom:1px solid rgba(210,168,92,.14);color:#C9C4B8;font-size:1rem;}
  .arc li .n{font-size:.7rem;letter-spacing:.14em;color:var(--star);min-width:54px;}
  .arc li.here{color:var(--paper);}
  .arc li.here .n{color:var(--star-bright);}
  .arc li.here .badge{font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--night);background:var(--star);border-radius:2px;padding:2px 8px;margin-left:auto;}
  .capture{display:flex;gap:12px;flex-wrap:wrap;max-width:46ch;margin-top:8px;}
  .capture input{flex:1;min-width:220px;background:rgba(242,236,222,.06);border:1px solid var(--rule-dark);border-radius:3px;padding:14px 16px;color:var(--paper);font-family:"EB Garamond",serif;font-size:1rem;}
  .capture input::placeholder{color:var(--mist-dim);}
  .capture input:focus{outline:none;border-color:var(--star);}
  .capture button{font-family:"EB Garamond",serif;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;background:var(--star);color:var(--night);border:none;border-radius:3px;padding:14px 26px;cursor:pointer;transition:background .25s ease;}
  .capture button:hover{background:var(--star-bright);}
  .capture .fineprint{flex-basis:100%;color:var(--mist-dim);font-size:.82rem;margin-top:6px;}
  .thanks{display:none;color:var(--star-bright);font-family:"Cormorant Garamond",serif;font-style:italic;font-size:1.3rem;margin-top:6px;}
  .handoff{margin-top:26px;padding-top:22px;border-top:1px solid rgba(210,168,92,.18);color:#C9C4B8;font-size:1rem;max-width:54ch;}
  .handoff a{color:var(--star-bright);text-decoration:none;border-bottom:1px solid rgba(230,192,121,.4);}
</style>
